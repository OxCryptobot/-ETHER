# @ETHER environment
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Model — must match `ollama list` exactly
# Host (GTX 1650 4GB / 12GB): Qwen 3.5 4B Q4_K_M only. Never >4B.
# ollama library qwen3.5:4b is already file_type=Q4_K_M (3.4GB).
# Prefer SHORT tag (always present after `ollama pull qwen3.5:4b`):
ETHER_PRIMARY_MODEL=qwen3.5:4b
# Explicit quant tag (optional, same weights):
# ETHER_PRIMARY_MODEL=qwen3.5:4b-q4_K_M
# Cousin / high-end only:
# ETHER_PRIMARY_MODEL=qwen2.5-coder:14b
# ETHER_HW_PROFILE=cousin

# Context — host must stay low to leave VRAM headroom for KV + tools
# ETHER_NUM_CTX=8192
# For any live experiment prefer 4096

ETHER_EMBED_MODEL=nomic-embed-text
ETHER_SANDBOX_TIMEOUT=120
ETHER_SANDBOX_RETRY=1
ETHER_LLM_PLAN=0
ETHER_USE_CONTEXT=1

# Sandbox backend:
#   auto   = Docker if present, else local (default)
#   docker = isolated container (required for verified execution product path)
#   local  = host python -I (weaker; trusted local only)
ETHER_SANDBOX_BACKEND=auto

# Warm sandbox: leave OFF (shared /tmp across programs).
ETHER_WARM_SANDBOX=0

# Learning
ETHER_LEARNING=1
ETHER_LEARN_EPSILON=0.15
ETHER_CURRICULUM=1
ETHER_EXPERIENCE=1
ETHER_RAG_BM25=1
ETHER_CURRICULUM_FAIL_RATE=0.4

# Tool fabrication — promote only under explicit gate
ETHER_AUTO_PROMOTE=0
ETHER_FABRICATE_STUB_ONLY=0

# Flywheel — default OFF push to origin/main (Stage 0 product rule)
# ETHER_FLYWHEEL_PUSH=1  # opt-in only
ETHER_FLYWHEEL_MIN_CONFIDENCE=0.7
ETHER_FLYWHEEL_MAX_RETRIES=3
ETHER_FLYWHEEL_INTERVAL=900

# Optional cloud burst (never commit real keys)
# ETHER_BURST=0
# ETHER_BURST_API_KEY=

# Phase B — Repo oracle (project-pytest scoring after sandbox)
# Set to 1 to force repair/retry when project tests fail even if sandbox exit=0.
# ETHER_REPO_ORACLE=0
# ETHER_REPO_ORACLE_FIXTURE=fixtures/repo_oracle_toy
# ETHER_REPO_ORACLE_TEST_ARGS=tests
# ETHER_REPO_ORACLE_TIMEOUT=60
# ETHER_REPO_ORACLE_AS_PATH=greeter.py

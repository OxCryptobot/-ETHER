# @ETHER environment — copied to .env once; autonomy reads this automatically
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

ETHER_PRIMARY_MODEL=qwen2.5-coder:3b
ETHER_EMBED_MODEL=nomic-embed-text
ETHER_SANDBOX_TIMEOUT=120
ETHER_SANDBOX_RETRY=1
ETHER_LLM_PLAN=0
ETHER_USE_CONTEXT=1

# Learning (bandit policy over coding strategies)
ETHER_LEARNING=1
ETHER_LEARN_EPSILON=0.15

# Autonomous flywheel
ETHER_FLYWHEEL_PUSH=1
ETHER_FLYWHEEL_MIN_CONFIDENCE=0.7
ETHER_FLYWHEEL_MAX_RETRIES=3
ETHER_FLYWHEEL_INTERVAL=900

# @ETHER environment
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Model — must match `ollama list` exactly
# Windows light box:
ETHER_PRIMARY_MODEL=qwen2.5-coder:3b
# Linux strong box / Qwen 3.6 (set real tag from ollama list):
# ETHER_PRIMARY_MODEL=qwen3:latest
# ETHER_PRIMARY_MODEL=qwen3:14b
# ETHER_PRIMARY_MODEL=qwen3:32b

ETHER_EMBED_MODEL=nomic-embed-text
ETHER_SANDBOX_TIMEOUT=120
ETHER_SANDBOX_RETRY=1
ETHER_LLM_PLAN=0
ETHER_USE_CONTEXT=1

# Sandbox backend:
#   auto   = Docker if present, else local (default)
#   docker = isolated container (Windows partner)
#   local  = host python3 -I, no Docker (Linux cousin)
ETHER_SANDBOX_BACKEND=auto
# ETHER_SANDBOX_BACKEND=local
# ETHER_SANDBOX_PYTHON=python3

# Learning
ETHER_LEARNING=1
ETHER_LEARN_EPSILON=0.15
ETHER_CURRICULUM=1
ETHER_EXPERIENCE=1
ETHER_RAG_BM25=1
ETHER_CURRICULUM_FAIL_RATE=0.4

# Tool fabrication
ETHER_AUTO_PROMOTE=0
ETHER_FABRICATE_STUB_ONLY=0

# Flywheel
ETHER_FLYWHEEL_PUSH=1
ETHER_FLYWHEEL_MIN_CONFIDENCE=0.7
ETHER_FLYWHEEL_MAX_RETRIES=3
ETHER_FLYWHEEL_INTERVAL=900

# Optional cloud burst (never commit real keys)
# ETHER_BURST=0
# ETHER_BURST_ON_FAIL=1
# ETHER_BURST_URL=https://api.groq.com/openai/v1
# ETHER_BURST_MODEL=llama-3.3-70b-versatile
# ETHER_BURST_API_KEY=

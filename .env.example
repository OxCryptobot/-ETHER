# @ETHER environment
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Primary model — pick what fits your GPU:
#   GTX 1650 4GB / 8-12GB RAM  → qwen2.5-coder:3b   (recommended default)
#   8GB+ VRAM                  → qwen2.5-coder:7b
#   16GB+ VRAM                 → qwen2.5-coder:14b
#   24GB+ VRAM                 → qwen2.5-coder:32b  (or qwen3-coder-next:32b-q4_k_m)
ETHER_PRIMARY_MODEL=qwen2.5-coder:3b

# Embeddings for Citrine workspace memory
ETHER_EMBED_MODEL=nomic-embed-text

# Sandbox timeout (seconds)
ETHER_SANDBOX_TIMEOUT=120

# Set to 1 to use LLM-assisted planning via Rose Quartz
ETHER_LLM_PLAN=0

# Auto-retry code gen once if sandbox fails (0/1)
ETHER_SANDBOX_RETRY=1

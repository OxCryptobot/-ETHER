# @ETHER environment
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Model — must match `ollama list` exactly
# Host (GTX 1650 4GB / 12GB): Qwen 3.5 4B preferred, ≤4B class only
ETHER_PRIMARY_MODEL=qwen3.5:4b
# Fallback if 4B tag differs on your machine:
# ETHER_PRIMARY_MODEL=qwen2.5-coder:3b
# Cousin / high-end only:
# ETHER_PRIMARY_MODEL=qwen2.5-coder:14b
# ETHER_HW_PROFILE=cousin

ETHER_EMBED_MODEL=nomic-embed-text
ETHER_SANDBOX_TIMEOUT=120
ETHER_SANDBOX_RETRY=1
ETHER_LLM_PLAN=0
ETHER_USE_CONTEXT=1

# Sandbox backend:
#   auto   = Docker if present, else local (default)
#   docker = isolated container (required for verified execution product path)
#   local  = host python -I (weaker; trusted local only)
ETHER_SANDBOX_BACKEND=auto

# Warm sandbox: leave OFF (shared /tmp across programs).
ETHER_WARM_SANDBOX=0

# Learning
ETHER_LEARNING=1
ETHER_LEARN_EPSILON=0.15
ETHER_CURRICULUM=1
ETHER_EXPERIENCE=1
ETHER_RAG_BM25=1
ETHER_CURRICULUM_FAIL_RATE=0.4

# Tool fabrication — promote only under explicit gate
ETHER_AUTO_PROMOTE=0
ETHER_FABRICATE_STUB_ONLY=0

# Flywheel — default OFF push to origin/main (Stage 0 product rule)
# ETHER_FLYWHEEL_PUSH=1  # opt-in only
ETHER_FLYWHEEL_MIN_CONFIDENCE=0.7
ETHER_FLYWHEEL_MAX_RETRIES=3
ETHER_FLYWHEEL_INTERVAL=900

# Optional cloud burst (never commit real keys)
# ETHER_BURST=0
# ETHER_BURST_API_KEY=

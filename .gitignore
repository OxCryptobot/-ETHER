*.log

# Job queue bodies — local only. Tracking them made `git reset --hard origin/main`
# resurrect failed greeter/merge samples forever.
artifacts/jobs/failed/*.json
artifacts/jobs/done/*.json
artifacts/jobs/failed_archived/*.json
artifacts/jobs/running/*.json

# Environment
.env
.env.*
!.env.example


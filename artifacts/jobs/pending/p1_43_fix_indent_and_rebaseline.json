{
  "id": "p1_43_fix_indent_and_rebaseline",
  "note": "CRITICAL: fix nested _system_prompt IndentationError then rebaseline scripted arms",
  "continue_on_fail": true,
  "class": "fast",
  "steps": [
    {
      "argv": [".venv/Scripts/python.exe", "-m", "scripts.fix_tool_runtime_indent"],
      "timeout": 60
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-c",
        "import ast; from pathlib import Path; ast.parse(Path('core/tool_runtime.py').read_text(encoding='utf-8')); from core.tool_runtime import ToolRuntime, TOOL_SPECS; assert hasattr(ToolRuntime, '_system_prompt'); print('tool_runtime_ok', len(TOOL_SPECS))"
      ],
      "timeout": 60
    },
    {
      "argv": ["git", "add", "-A", "--", "core/tool_runtime.py"],
      "timeout": 60
    },
    {
      "argv": ["git", "commit", "-m", "fix(tool_runtime): un-nest _system_prompt — restore AST compile"],
      "timeout": 60,
      "continue_on_fail": true
    },
    {
      "argv": ["git", "push", "origin", "main"],
      "timeout": 120,
      "continue_on_fail": true
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "scripts.batch_phase_d",
        "--arm",
        "direct",
        "--mode",
        "scripted",
        "--tier",
        "hard",
        "--scoreboard",
        "artifacts/scoreboard_p1_43_direct.json"
      ],
      "timeout": 600
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "scripts.batch_phase_d",
        "--arm",
        "pipeline",
        "--mode",
        "scripted",
        "--tier",
        "hard",
        "--scoreboard",
        "artifacts/scoreboard_p1_43_pipeline.json"
      ],
      "timeout": 600
    },
    {
      "argv": [".venv/Scripts/python.exe", "-m", "scripts.write_whats_next"],
      "timeout": 60
    }
  ]
}

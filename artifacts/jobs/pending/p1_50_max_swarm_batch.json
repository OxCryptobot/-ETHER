{
  "id": "p1_50_max_swarm_batch",
  "note": "Max swarm: mentor v2 doctrine + dual-arm protect + train_gates + whats_next + archive",
  "continue_on_fail": true,
  "class": "fast",
  "steps": [
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-c",
        "from core.coding_method import default_method, prompt_suffix, SYSTEM_RULES, STEP_ORDER; m=default_method(); assert m.name=='ether_tool_first_v1'; assert 'run_tests' in prompt_suffix(); assert 'apply_patch' in STEP_ORDER; print('mentor_ok', len(SYSTEM_RULES), m.checklist())"
      ],
      "timeout": 60
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "pytest",
        "tests/test_coding_method.py",
        "tests/test_train_gates.py",
        "tests/test_preference_rlhf.py",
        "-q",
        "--tb=line"
      ],
      "timeout": 240,
      "continue_on_fail": true
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "scripts.batch_phase_d",
        "--arm",
        "direct",
        "--mode",
        "scripted",
        "--tier",
        "hard",
        "--scoreboard",
        "artifacts/scoreboard_p1_50_direct.json"
      ],
      "timeout": 600
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "scripts.batch_phase_d",
        "--arm",
        "pipeline",
        "--mode",
        "scripted",
        "--tier",
        "hard",
        "--scoreboard",
        "artifacts/scoreboard_p1_50_pipeline.json"
      ],
      "timeout": 600
    },
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-c",
        "from pathlib import Path; import json; p=Path('artifacts/lessons/024_mentor_coding_method_v2.json'); assert p.exists(); d=json.loads(p.read_text(encoding='utf-8')); assert d['id']=='024_mentor_coding_method_v2'; print('lesson_024_ok')"
      ],
      "timeout": 30
    },
    {
      "argv": [".venv/Scripts/python.exe", "-m", "scripts.write_whats_next"],
      "timeout": 60
    },
    {
      "argv": [".venv/Scripts/python.exe", "-m", "scripts.ether_cli", "status"],
      "timeout": 60,
      "continue_on_fail": true
    }
  ]
}

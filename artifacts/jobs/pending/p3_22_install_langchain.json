{
  "id": "p3_22_install_langchain",
  "class": "fast",
  "note": "Install optional ether[langchain] into the host venv. Does not lift wheels.",
  "continue_on_fail": true,
  "steps": [
    {
      "argv": [
        ".venv/Scripts/python.exe",
        "-m",
        "pip",
        "install",
        "-e",
        ".[langchain]"
      ],
      "timeout": 300
    },
    {
      "argv": [".venv/Scripts/python.exe", "-m", "core.langchain_adapter"],
      "timeout": 60
    },
    {
      "argv": [".venv/Scripts/python.exe", "-m", "core.operator_answers"],
      "timeout": 30
    }
  ]
}
